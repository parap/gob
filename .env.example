# Copy to .env and fill in. .env is gitignored; this repository is public, so a working
# password committed here would be a published credential.
#
#   cp .env.example .env && chmod 600 .env
#
# The server's .env is a different file with different passwords, created there by
# bin/deploy.sh and never copied from a laptop.

# --- database ---------------------------------------------------------------------------
# Used for both the `gob` application user and, separately, the root account.
DB_PASS=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- where ports bind -------------------------------------------------------------------
# A laptop wants the game on every interface so a phone on the same wifi can open it.
# A deployment behind the shared proxy wants the loopback and nothing else:
#
#   WEB_BIND=127.0.0.1:8090
#
WEB_BIND=8090

# Admin surfaces stay on the loopback everywhere. A published port is not covered by the
# host firewall — Docker routes it through its own nat and FORWARD chains, not INPUT — so
# "the firewall will catch it" is not true of anything listed here.
PMA_BIND=127.0.0.1:8091
DB_BIND=127.0.0.1:3307
